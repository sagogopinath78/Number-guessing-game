import random


lower_bound = 1
upper_bound = 50
max_attempts = 5


secret_number = random.randint(lower_bound, upper_bound)

print(f"Welcome to the Number Guessing Game!")
print(f"I am thinking of a number between {lower_bound} and {upper_bound}.")
print(f"You have {max_attempts} attempts to guess it. Good luck!\n")


for attempt in range(1, max_attempts + 1):
  
    guess = int(input(f"Attempt {attempt}/{max_attempts} - Enter your guess: "))
    
    
    if guess == secret_number:
        print(f"🎉 Correct! You guessed the number in {attempt} attempts!")
        break
    elif guess < secret_number:
        print("Too low! Try a higher number.\n")
    else:
        print("Too high! Try a lower number.\n")


else:
    print(f"❌ Game Over! You've run out of attempts.")
    print(f"The correct number was {secret_number}. Better luck next time!")
